# --- Database (Neon in production, local Docker Postgres+PostGIS in dev) ---
DATABASE_URL="postgresql://fleetcaring:fleetcaring_dev@localhost:5432/fleetcaring?schema=public"

# --- Redis (BullMQ queues + pub/sub for WS fan-out) ---
REDIS_URL="redis://localhost:6379"

# --- JWT ---
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# --- Twilio (OTP) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Firebase Cloud Messaging ---
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# --- Cloudflare R2 (S3-compatible photo/document storage) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="fleetcaring-uploads"

# --- App ---
PORT="4000"
NODE_ENV="development"
CORS_ORIGIN="*"
